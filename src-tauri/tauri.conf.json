{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Mobile Bridge Tauri",
  "version": "2.1.1",
  "identifier": "io.github.weworker.codexmobilebridge.tauri",
  "build": {
    "beforeBuildCommand": "python scripts/prepare-tauri.py",
    "beforeDevCommand": "python scripts/prepare-tauri.py",
    "frontendDist": "../.tmp/tauri-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../desktop/assets/icon.ico", "../desktop/assets/icon.png"],
    "resources": {"../dist/gateway/": "gateway/", "../LICENSE": "LICENSE"},
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper"},
      "nsis": {"installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": true}
    }
  }
}
